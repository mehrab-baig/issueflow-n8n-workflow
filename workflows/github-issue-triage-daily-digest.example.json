    {
      "parameters": {
        "jsCode": "let total = 0, urgent = 0, high = 0, normal = 0, low = 0;\nlet bugs = 0, features = 0, questions = 0, review = 0;\n\n// Loop through every issue we got from the Filter node\nfor (const item of $input.all()) {\n  total++;\n  \n  let priority = item.json.priority || '';\n  let type = item.json.issue_type || '';\n\n  // Count Priorities\n  if (priority === 'urgent') urgent++;\n  if (priority === 'high') high++;\n  if (priority === 'normal') normal++;\n  if (priority === 'low') low++;\n\n  // Count Types\n  if (type === 'bug') bugs++;\n  if (type === 'feature') features++;\n  if (type === 'question') questions++;\n  if (type === 'other' || type === '') review++;\n}\n\n// Output one single summary card\nreturn [{\n  json: {\n    total_open: total,\n    urgent: urgent,\n    high: high,\n    normal: normal,\n    low: low,\n    bugs: bugs,\n    features: features,\n    questions: questions,\n    needs_review: review\n  }\n}];\n"
      },
